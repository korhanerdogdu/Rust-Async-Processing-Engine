# Copy to `.env` for host runs (`cargo run -p worker-engine` / `-p api-gateway`).
# Both binaries load `.env` from the current directory (dotenvy) and then
# real environment variables win. Invalid values are startup errors.
# No secrets are hard-coded in code: the password below is a LOCAL DEV value.

# ---------- shared ----------
DATABASE_URL=postgres://engine:engine_dev_password@127.0.0.1:55432/engine
RUST_LOG=info,sqlx=warn
LOG_FORMAT=pretty                         # pretty | json
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318   # unset = no span export (ids still propagate)
TOKIO_WORKER_THREADS=                     # default: available_parallelism
DB_LOG_CAPACITY=8192                      # bounded log channel; overflow is dropped + counted
DB_LOG_LEVEL=INFO
METRICS_FLUSH_MS=5000                     # metrics snapshot -> operational_metrics

# ---------- validation limits (keep identical in both processes) ----------
MAX_PAYLOAD_BYTES=524288
MAX_JSON_INPUT_BYTES=262144
MAX_TEXT_BYTES=65536
MAX_DELAY_MS=60000
MAX_HTML_BYTES=262144
MAX_CPU_SPAN=50000000
MAX_CPU_VALUE=10000000000
MAX_CPU_CHUNKS=4096

# ---------- worker-engine (process 2, internal only) ----------
WORKER_GRPC_ADDR=127.0.0.1:50052          # never expose publicly
WORKER_ID=worker-1                        # stable id; lease owner = <id>:<boot uuid>
QUEUE_CAPACITY=64                         # bounded MPSC capacity
MAX_ACTIVE_JOBS=1                         # semaphore permits (1 = visible queueing)
ENQUEUE_TIMEOUT_MS=0                      # 0 = reject immediately when the queue is full (429)
MAX_ATTEMPTS=3
RETRY_BASE_MS=1000
RETRY_MAX_MS=30000
LEASE_GRACE_MS=15000
RECONCILE_INTERVAL_MS=2000
SHUTDOWN_GRACE_MS=10000
STATUS_CHANNEL_CAPACITY=1024
MAX_STATUS_SUBSCRIBERS=16
JOB_TIMEOUT_JSON_MS=5000
JOB_TIMEOUT_TEXT_MS=5000
JOB_TIMEOUT_DELAY_MS=65000
JOB_TIMEOUT_PDF_MS=45000
JOB_TIMEOUT_CPU_MS=120000
RAYON_THREADS=                            # default: available_parallelism
CPU_MAX_CONCURRENT_JOBS=1
ARTIFACT_DIR=data/artifacts
PDF_BROWSER_PATH=                         # default: auto-detect Chrome/Chromium/Edge
PDF_TIMEOUT_MS=30000
PDF_MAX_CONCURRENCY=2
PDF_MAX_BYTES=20971520
PDF_NO_SANDBOX=false                      # true ONLY in local containers (see README "Security")
DB_MAX_CONNECTIONS=20                     # worker pool; DB commit latency bounds throughput (see docs/test-report.md)
MIGRATE_ON_START=true

# ---------- api-gateway (process 1, public) ----------
GATEWAY_HTTP_ADDR=127.0.0.1:8080
GATEWAY_GRPC_ADDR=127.0.0.1:50051
WORKER_ENDPOINT=http://127.0.0.1:50052
REQUEST_TIMEOUT_MS=15000
WORKER_RPC_TIMEOUT_MS=5000
WORKER_CONNECT_TIMEOUT_MS=1000
MAX_INFLIGHT_REQUESTS=1024
MAX_BODY_BYTES=1048576
MAX_WS_CONNECTIONS=1000
METRICS_TOKEN=                            # set to require `Authorization: Bearer <token>` on /api/v1/metrics
